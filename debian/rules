#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

# Windows checkouts do not preserve the executable bit; force the
# correct modes on the shipped scripts before packaging.
execute_before_dh_installdeb:
	chmod 0755 debian/openmediavault-webtop.postinst
	chmod 0755 debian/openmediavault-webtop.prerm
	chmod 0755 debian/openmediavault-webtop.postrm
	chmod 0755 debian/openmediavault-webtop/usr/sbin/omv-webtop-ctl || true
	chmod 0755 debian/openmediavault-webtop/usr/share/openmediavault/confdb/create.d/*.sh
