{
	"type": "config",
	"id": "conf.service.webtop",
	"title": "Webtop",
	"queryinfo": {
		"xpath": ".//services/webtop",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"version": {
			"type": "string",
			"default": "latest"
		},
		"httpPort": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 3000
		},
		"httpsPort": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 3001
		},
		"timeZone": {
			"type": "string",
			"default": "Etc/UTC"
		},
		"configRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"sourceRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"customUser": {
			"type": "string",
			"default": "admin"
		},
		"password": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": "Webtop"
		},
		"puid": {
			"type": "integer",
			"default": 1000
		},
		"pgid": {
			"type": "integer",
			"default": 100
		}
	}
}
